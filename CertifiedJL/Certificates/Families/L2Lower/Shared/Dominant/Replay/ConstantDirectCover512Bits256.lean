    allEntries45_valid, ConstantDirectCover128Shard46.entries_valid]

private theorem targetCellA_valid {cell : Cell} (hvalid : cell.Valid) :
    (targetCellA cell).Valid := by
  unfold targetCellA
  split_ifs with h8 h14
  · subst cell
    norm_num [cell8Target, ConstantDirectCover128Shard02.cell8,
      Cell.Valid, Cell.decode, ThresholdDominantCellRowBounds.Valid,
      ThresholdDominantCellRowBoundsAt.Valid]
  · subst cell
    norm_num [cell14A, ConstantDirectCover128Shard03.cell14,
      Cell.Valid, Cell.decode, ThresholdDominantCellRowBounds.Valid,
      ThresholdDominantCellRowBoundsAt.Valid]
  · exact hvalid

private theorem exactCertificate_valid (cell : Cell) :
    (exactCertificate cell).Valid := by
  simp [exactCertificate, Certificate.Valid]

private theorem cell14A_valid : cell14A.Valid := by
  norm_num [cell14A, ConstantDirectCover128Shard03.cell14,
    Cell.Valid, Cell.decode, ThresholdDominantCellRowBounds.Valid,
    ThresholdDominantCellRowBoundsAt.Valid]

/-- Every inherited selector cell, after the target mapping, satisfies the
512/57 high-activity budget. -/
theorem allEntries_boundA {entry : Entry}
    (hmem : entry ∈ ConstantDirectCover128Shard46.allEntries) :
    thresholdDominantCellMajorantAt 512 57
        ((targetCellA entry.cell).decodeAt 512) < (budget : ℝ) := by
  have hvalidAll := allEntries46_valid
  rw [entriesValidCheck, List.all_eq_true] at hvalidAll
  have hentryValid := entryValidCheck_sound (hvalidAll entry hmem)
  have hcertifiedAll := allEntries46_certified
  rw [List.all_eq_true] at hcertifiedAll
  exact localCertifiedCheckFor_sound 512 57 (targetCellA entry.cell)
    (exactCertificate (targetCellA entry.cell)) budget
    (targetCellA_valid hentryValid.1)
    (exactCertificate_valid _)
    (hcertifiedAll entry hmem)

private theorem cell14B_valid : cell14B.Valid := by
  norm_num [cell14B, ConstantDirectCover128Shard03.cell14,
    Cell.Valid, Cell.decode, ThresholdDominantCellRowBounds.Valid,
    ThresholdDominantCellRowBoundsAt.Valid]

private theorem cell14B_bound :
    thresholdDominantCellMajorantAt 512 57 (cell14B.decodeAt 512) <
      (budget : ℝ) :=
  localCertifiedCheckFor_sound 512 57 cell14B (exactCertificate cell14B)
    budget cell14B_valid (exactCertificate_valid _)
      ConstantDirectCover512Bits256.cell14B_certified

/-- Exact no-gap direct cover at 512 rows, floor 57, and 256 bits. -/
theorem exists_cover_cell (u r B : ℝ)
    (huZero : 0 ≤ u) (huHalf : u ≤ 1 / 2)
    (hrZero : 0 ≤ r) (hrUpper : r ≤ 2500 / 2401)
    (hrFeasible : r ≤ 1 + u) (hBtwo : 2 ≤ B)
    (hrModulus : 9 * r ≤ B ^ 2) :
    ∃ entry : Entry,
      entry.cell.Valid ∧
      (entry.cell.lower : ℝ) ≤ u ∧
      u ≤ (entry.cell.upper : ℝ) ∧
      r ≤ (entry.cell.thresholdUpper : ℝ) ∧
      (entry.cell.modulusLower : ℝ) ≤ B ∧
      thresholdDominantCellMajorantAt 512 57
        (entry.cell.decodeAt 512) < (budget : ℝ) := by
  obtain ⟨entry, hvalid, huLower, huUpper, hrCell, hBCell, hboundA⟩ :=
    ConstantDirectCover128Selector.exists_cover_cell_of_property
      (fun cell => thresholdDominantCellMajorantAt 512 57
        ((targetCellA cell).decodeAt 512) < (budget : ℝ))
      (fun entry hmem => allEntries_boundA hmem)
      u r B huZero huHalf hrZero hrUpper hrFeasible hBtwo hrModulus
  by_cases h14 : entry.cell = ConstantDirectCover128Shard03.cell14
  · have huUpperOrig : u ≤ (1 / 512 : ℝ) := by
      simpa [h14, ConstantDirectCover128Shard03.cell14] using huUpper
    have hrTarget : r ≤ (cell14A.thresholdUpper : ℝ) := by
      simpa [cell14A, h14, ConstantDirectCover128Shard03.cell14] using hrCell
    have hBTarget : (cell14A.modulusLower : ℝ) ≤ B := by
      simpa [cell14A, h14, ConstantDirectCover128Shard03.cell14] using hBCell
    by_cases huMid : u ≤ (1 / 1024 : ℝ)
    · refine ⟨⟨cell14A, exactCertificate cell14A⟩, cell14A_valid, ?_, ?_,
        hrTarget, hBTarget, ?_⟩
      · simpa [cell14A, ConstantDirectCover128Shard03.cell14] using huZero
      · simpa [cell14A, ConstantDirectCover128Shard03.cell14] using huMid
      · simpa [targetCellA, h14, cell14A,
          ConstantDirectCover128Shard02.cell8,
          ConstantDirectCover128Shard03.cell14] using hboundA
    · have huMidLower : (1 / 1024 : ℝ) ≤ u := le_of_not_ge huMid
      refine ⟨⟨cell14B, exactCertificate cell14B⟩, cell14B_valid,
        ?_, ?_, ?_, ?_, cell14B_bound⟩
      · simpa [cell14B, ConstantDirectCover128Shard03.cell14] using huMidLower
      · simpa [cell14B, ConstantDirectCover128Shard03.cell14] using huUpperOrig
      · simpa [cell14A, cell14B, ConstantDirectCover128Shard03.cell14] using hrTarget
      · simpa [cell14A, cell14B, ConstantDirectCover128Shard03.cell14] using hBTarget
  · refine ⟨⟨targetCellA entry.cell, exactCertificate (targetCellA entry.cell)⟩,
      targetCellA_valid hvalid, ?_, ?_, ?_, ?_, hboundA⟩
    · by_cases h8 : entry.cell = ConstantDirectCover128Shard02.cell8
      · simpa [targetCellA, h8, cell8Target] using huLower
      · simpa [targetCellA, h8, h14] using huLower
    · by_cases h8 : entry.cell = ConstantDirectCover128Shard02.cell8
      · simpa [targetCellA, h8, cell8Target] using huUpper
      · simpa [targetCellA, h8, h14] using huUpper
    · by_cases h8 : entry.cell = ConstantDirectCover128Shard02.cell8
      · simpa [targetCellA, h8, cell8Target] using hrCell
      · simpa [targetCellA, h8, h14] using hrCell
    · by_cases h8 : entry.cell = ConstantDirectCover128Shard02.cell8
      · simpa [targetCellA, h8, cell8Target] using hBCell
      · simpa [targetCellA, h8, h14] using hBCell

end CertifiedJL.SparseThresholdDominant.ConstantDirectCover512Bits256
