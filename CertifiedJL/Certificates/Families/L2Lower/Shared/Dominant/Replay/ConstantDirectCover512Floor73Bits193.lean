/-- Every cell selected by the inherited no-gap tree satisfies the
512-row, floor-73, 193-bit high-activity budget. -/
theorem allEntries_bound {entry : Entry}
    (hmem : entry ∈ ConstantDirectCover128Shard46.allEntries) :
    thresholdDominantCellMajorantAt 512 73 (entry.cell.decodeAt 512) <
      (budget : ℝ) := by
  apply entry_boundAt_of_mem_of_checks 512 73
    ConstantDirectCover128Shard46.allEntries budget
    ConstantDirectCover128Shard46.allEntries_valid_check
    (by simpa [targetCheck, entriesCertifiedCheckFor] using allEntries_certified)
    hmem

/-- Exact no-gap direct cover at 512 rows, floor 73, and 193 bits. -/
theorem exists_cover_cell (u r B : ℝ)
    (huZero : 0 ≤ u) (huHalf : u ≤ 1 / 2)
    (hrZero : 0 ≤ r) (hrUpper : r ≤ 2500 / 2401)
    (hrFeasible : r ≤ 1 + u) (hBtwo : 2 ≤ B)
    (hrModulus : 9 * r ≤ B ^ 2) :
    ∃ entry : Entry,
      entry.cell.Valid ∧
      (entry.cell.lower : ℝ) ≤ u ∧
      u ≤ (entry.cell.upper : ℝ) ∧
      r ≤ (entry.cell.thresholdUpper : ℝ) ∧
      (entry.cell.modulusLower : ℝ) ≤ B ∧
      thresholdDominantCellMajorantAt 512 73
        (entry.cell.decodeAt 512) < (budget : ℝ) :=
  ConstantDirectCover128Selector.exists_cover_cell_at 512 73 budget
    (fun _ hmem => allEntries_bound hmem)
    u r B huZero huHalf hrZero hrUpper hrFeasible hBtwo hrModulus

