set_option maxRecDepth 100000 in
private theorem allEntries_retargeted_valid :
    ConstantDirectCover128Shard46.allEntries.all
      (fun entry => entryValidCheck (retargetEntry entry)) = true := by
  decide +kernel

theorem bound_of_mem {entry : Entry}
    (hmem : entry ∈ ConstantDirectCover128Shard46.allEntries) :
    thresholdDominantCellMajorantAt 192 12
        ((retargetEntry entry).cell.decodeAt 192) < (budget : ℝ) := by
  have hcertified := allEntries_certified
  rw [List.all_eq_true] at hcertified
  have hvalid := allEntries_retargeted_valid
  rw [List.all_eq_true] at hvalid
  have hv := entryValidCheck_sound (hvalid entry hmem)
  exact localCertifiedCheckFor_sound 192 12
    (retargetEntry entry).cell (retargetEntry entry).certificate budget
    hv.1 hv.2 (hcertified entry hmem)

private theorem retargetCell_geometry (cell : Cell) :
    (retargetCell cell).lower = cell.lower ∧
    (retargetCell cell).upper = cell.upper ∧
    (retargetCell cell).thresholdUpper = cell.thresholdUpper ∧
    (retargetCell cell).modulusLower = cell.modulusLower := by
  unfold retargetCell
  split_ifs with h
  · subst cell
    simp [targetCell95]
  · simp

private theorem retargetCell_valid {cell : Cell} (hvalid : cell.Valid) :
    (retargetCell cell).Valid := by
  unfold retargetCell
  split_ifs with h
  · subst cell
    norm_num [targetCell95, ConstantDirectCover128Shard23.cell95,
      Cell.Valid, Cell.decode, ThresholdDominantCellRowBounds.Valid,
      ThresholdDominantCellRowBoundsAt.Valid]
  · exact hvalid

/-- Exact no-gap direct cover at the 192-row, floor-12 target. -/
theorem exists_cover_cell (u r B : ℝ)
    (huZero : 0 ≤ u) (huHalf : u ≤ 1 / 2)
    (hrZero : 0 ≤ r) (hrUpper : r ≤ 2500 / 2401)
    (hrFeasible : r ≤ 1 + u) (hBtwo : 2 ≤ B)
    (hrModulus : 9 * r ≤ B ^ 2) :
    ∃ entry : Entry,
      entry.cell.Valid ∧
      (entry.cell.lower : ℝ) ≤ u ∧
      u ≤ (entry.cell.upper : ℝ) ∧
      r ≤ (entry.cell.thresholdUpper : ℝ) ∧
      (entry.cell.modulusLower : ℝ) ≤ B ∧
      thresholdDominantCellMajorantAt 192 12
        (entry.cell.decodeAt 192) < (budget : ℝ) := by
  obtain ⟨entry, hvalid, hlower, hupper, hthreshold, hmodulus, hbound⟩ :=
    ConstantDirectCover128Selector.exists_cover_cell_of_property
      (P := fun cell =>
        thresholdDominantCellMajorantAt 192 12
          ((retargetCell cell).decodeAt 192) < (budget : ℝ))
      (fun entry hmem => by
        simpa [retargetEntry] using bound_of_mem hmem)
      u r B huZero huHalf hrZero hrUpper hrFeasible hBtwo hrModulus
  have hgeometry := retargetCell_geometry entry.cell
  refine ⟨retargetEntry entry, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact retargetCell_valid hvalid
  · simpa [retargetEntry, hgeometry.1] using hlower
  · simpa [retargetEntry, hgeometry.2.1] using hupper
  · simpa [retargetEntry, hgeometry.2.2.1] using hthreshold
  · simpa [retargetEntry, hgeometry.2.2.2] using hmodulus
  · simpa [retargetEntry] using hbound

end CertifiedJL.SparseThresholdDominant.ConstantDirectCover192Bits128
