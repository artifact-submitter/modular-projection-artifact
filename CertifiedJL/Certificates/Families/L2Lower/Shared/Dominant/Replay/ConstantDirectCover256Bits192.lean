    {entry : Entry} (hvalid : entry.certificate.Valid) :
    (targetCertificate entry).Valid := by
  change (ConstantDirectCover256And384Bits192Caps.targetCertificate entry).Valid
  unfold ConstantDirectCover256And384Bits192Caps.targetCertificate
  split_ifs
  · norm_num [ConstantDirectCover256And384Bits192Caps.certificate8,
      Certificate.Valid]
  · norm_num [ConstantDirectCover256And384Bits192Caps.certificate14,
      Certificate.Valid]
  · norm_num [ConstantDirectCover256And384Bits192Caps.certificate15,
      Certificate.Valid]
  · exact hvalid

/-- Every cell selected by the inherited no-gap tree satisfies the 256/9
high-activity budget. -/
theorem allEntries_bound {entry : Entry}
    (hmem : entry ∈ ConstantDirectCover128Shard46.allEntries) :
    thresholdDominantCellMajorantAt 256 9 (entry.cell.decodeAt 256) <
      ((99 / (100 * 2 ^ 192) : ℚ) : ℝ) := by
  have hvalidAll := allEntries46_valid
  rw [entriesValidCheck, List.all_eq_true] at hvalidAll
  have hentryValid := entryValidCheck_sound (hvalidAll entry hmem)
  have htargetValid := targetCertificate_valid_of_valid hentryValid.2
  have hcertifiedAll := allEntries46_certified
  rw [List.all_eq_true] at hcertifiedAll
  exact localCertifiedCheckFor_sound 256 9 entry.cell
    (targetCertificate entry) budget hentryValid.1 htargetValid
    (hcertifiedAll entry hmem)

/-- Exact no-gap direct cover at the 256-row, floor-9 target. -/
theorem exists_cover_cell (u r B : ℝ)
    (huZero : 0 ≤ u) (huHalf : u ≤ 1 / 2)
    (hrZero : 0 ≤ r) (hrUpper : r ≤ 2500 / 2401)
    (hrFeasible : r ≤ 1 + u) (hBtwo : 2 ≤ B)
    (hrModulus : 9 * r ≤ B ^ 2) :
    ∃ entry : Entry,
      entry.cell.Valid ∧
      (entry.cell.lower : ℝ) ≤ u ∧
      u ≤ (entry.cell.upper : ℝ) ∧
      r ≤ (entry.cell.thresholdUpper : ℝ) ∧
      (entry.cell.modulusLower : ℝ) ≤ B ∧
      thresholdDominantCellMajorantAt 256 9
        (entry.cell.decodeAt 256) < ((99 / (100 * 2 ^ 192) : ℚ) : ℝ) :=
  ConstantDirectCover128Selector.exists_cover_cell_at 256 9
    (99 / (100 * 2 ^ 192)) (fun _ hmem => allEntries_bound hmem)
    u r B huZero huHalf hrZero hrUpper hrFeasible hBtwo hrModulus

end CertifiedJL.SparseThresholdDominant.ConstantDirectCover256Bits192
